<%- include('partials_header') %>

<main class="container admin-page">
  <div class="admin-top">
    <h1>Админ-панель</h1>
    <form method="post" action="/admin/logout">
      <button type="submit" class="ghost">Выйти</button>
    </form>
  </div>

  <% if (error) { %>
    <p class="error"><%= error %></p>
  <% } %>
  <% if (success) { %>
    <p class="success"><%= success %></p>
  <% } %>

  <section class="admin-section">
    <h2>Настройки сайта</h2>
    <form method="post" action="/admin/settings" class="form-grid">
      <label>Название сайта
        <input type="text" name="siteTitle" value="<%= settings.siteTitle %>" required />
      </label>
      <label>Текст логотипа
        <input type="text" name="logoText" value="<%= settings.logoText %>" required />
      </label>
      <button type="submit">Сохранить настройки</button>
    </form>
  </section>

  <section class="admin-section">
    <h2>Сменить логин и пароль админ-панели</h2>
    <form method="post" action="/admin/credentials" class="form-grid">
      <label>Текущий пароль
        <input type="password" name="currentPassword" required />
      </label>
      <label>Новый логин
        <input type="text" name="newLogin" required />
      </label>
      <label>Новый пароль
        <input type="password" name="newPassword" required />
      </label>
      <button type="submit">Обновить данные входа</button>
    </form>
  </section>

  <section class="admin-section">
    <h2>Добавить товар</h2>
    <form method="post" action="/admin/product" class="form-grid">
      <label>Название
        <input type="text" name="title" required />
      </label>
      <label>Описание
        <textarea name="description" required></textarea>
      </label>
      <label>Цена (₽)
        <input type="number" name="price" min="1" required />
      </label>
      <label>URL картинки
        <input type="url" name="image" required />
      </label>
      <label>Ссылка покупки (другой сайт)
        <input type="url" name="purchaseUrl" required />
      </label>
      <button type="submit">Добавить товар</button>
    </form>
  </section>

  <section class="admin-section">
    <h2>Товары</h2>
    <div class="admin-products">
      <% products.forEach((product) => { %>
        <article class="admin-item">
          <img src="<%= product.image %>" alt="<%= product.title %>" />
          <div>
            <h3><%= product.title %></h3>
            <p><%= formatRub(product.price) %></p>
            <small>ID: <%= product.id %></small>
          </div>
          <form method="post" action="/admin/product/delete">
            <input type="hidden" name="id" value="<%= product.id %>" />
            <button type="submit" class="danger">Удалить</button>
          </form>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials_footer') %>
