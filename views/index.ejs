<%- include('partials_header') %>

<main class="container">
  <h1>Каталог товаров</h1>
  <section class="grid">
    <% products.forEach((product) => { %>
      <article class="card">
        <a href="/product/<%= product.id %>">
          <img src="<%= product.image %>" alt="<%= product.title %>" class="card-image" />
        </a>
        <div class="card-body">
          <a href="/product/<%= product.id %>" class="card-title"><%= product.title %></a>
          <p class="card-price"><%= formatRub(product.price) %></p>
        </div>
      </article>
    <% }) %>
  </section>
</main>

<div class="modal" id="admin-modal" hidden>
  <form class="modal-content" method="post" action="/admin/login">
    <h2>Вход в админ-панель</h2>
    <label>Логин
      <input type="text" name="login" required />
    </label>
    <label>Пароль
      <input type="password" name="password" required />
    </label>
    <button type="submit">Войти</button>
    <button type="button" id="close-modal" class="ghost">Отмена</button>
  </form>
</div>

<%- include('partials_footer') %>
